# Supabase Configuration Example
# Replace these values with your actual Supabase project credentials in .env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Secret)
# Enables administrators to directly provision staff accounts without email verification limits.
# Found in: Supabase Dashboard > Project Settings > API > service_role secret key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

